{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ullaslab.co.in/schema/chart.schema.json",
  "title": "UllasLab chart JSON",
  "type": "object",
  "required": ["type", "title", "source", "freshness"],
  "additionalProperties": false,
  "$defs": {
    "i18n": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": { "x": { "type": ["string", "number"] }, "y": { "type": "number" } }
    },
    "series": {
      "type": "object",
      "required": ["name", "points"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/i18n" },
        "color": { "enum": ["primary", "secondary", "accent", "muted"] },
        "points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } }
      }
    }
  },
  "properties": {
    "type": { "enum": ["line", "bar", "compare", "delta", "counter"] },
    "title": { "$ref": "#/$defs/i18n" },
    "unit": { "type": "string" },
    "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
    "series": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/series" } },
    "value": { "type": "number" },
    "prior": { "type": "number" },
    "label": { "$ref": "#/$defs/i18n" },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object", "required": ["x", "label"], "additionalProperties": false,
        "properties": { "x": { "type": ["string", "number"] }, "label": { "$ref": "#/$defs/i18n" } }
      }
    },
    "source": {
      "type": "object", "required": ["name", "as_of"], "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "freshness": { "enum": ["LIVE", "RECENT", "LAGGED", "EXPECTATION", "INFERRED"] },
    "claim_id": { "type": "string" },
    "chart_hash": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "enum": ["line", "bar", "compare"] } } }, "then": { "required": ["series"] } },
    { "if": { "properties": { "type": { "enum": ["counter"] } } }, "then": { "required": ["value"] } },
    { "if": { "properties": { "type": { "const": "compare" } } }, "then": { "properties": { "series": { "minItems": 2 } } } },
    { "if": { "properties": { "type": { "const": "delta" } } }, "then": { "required": ["value", "prior"] } }
  ]
}
