{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn.ullaslab.co.in/schemas/scenes.schema.json",
  "title": "UllasLab scenes.json (director output, schema v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "item", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "item": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9][a-z0-9-]*$"},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/output"}
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "aspect", "scenes"],
      "properties": {
        "output": {"enum": ["long", "short", "reel"]},
        "aspect": {"enum": ["16:9", "9:16"]},
        "hook_type": {"type": "string", "maxLength": 80},
        "scenes": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/scene"}}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "narration", "visual_objective", "type", "palette",
                   "camera_move", "transition", "sfx", "rationale"],
      "properties": {
        "id": {"type": "string", "pattern": "^s\\d{2,3}$"},
        "role": {"enum": ["hook", "setup", "evidence", "mechanism", "consequence", "payoff",
                          "interrupt", "cta", "disclaimer"]},
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "start_s": {"type": ["number", "null"], "minimum": 0},
            "end_s": {"type": ["number", "null"], "minimum": 0},
            "words": {
              "type": ["array", "null"],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["w", "start", "end"],
                "properties": {
                  "w": {"type": "string"},
                  "start": {"type": "number", "minimum": 0},
                  "end": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        },
        "visual_objective": {"type": "string", "minLength": 8, "maxLength": 240},
        "type": {"enum": ["footage", "map", "globe", "chart", "timeline", "flow", "kinetic"]},
        "search_terms": {
          "type": "array",
          "items": {"type": "string", "minLength": 6, "maxLength": 80},
          "uniqueItems": true
        },
        "illustrative": {"type": "boolean"},
        "on_screen_text": {"type": ["string", "null"], "maxLength": 90},
        "data_ref": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": {"enum": ["chart", "data_point", "ledger"]},
            "ref": {"type": "string", "minLength": 1}
          }
        },
        "palette": {"enum": ["policy", "commodities", "trade", "tech", "volatility"]},
        "camera_move": {"enum": ["static", "slow_push", "pull_back", "pan_left", "pan_right",
                                 "tilt_up", "orbit", "zoom_to_region"]},
        "transition": {"enum": ["cut", "crossfade", "push", "wipe", "match_cut", "dip_to_black",
                                "pattern_interrupt"]},
        "sfx": {"enum": ["none", "tick", "whoosh", "riser", "hit", "page_turn", "ambient_low"]},
        "callback_to": {"type": ["string", "null"], "pattern": "^s\\d{2,3}$"},
        "rationale": {"type": "string", "minLength": 12, "maxLength": 400}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "footage"}}, "required": ["type"]},
          "then": {
            "required": ["search_terms", "illustrative"],
            "properties": {"search_terms": {"minItems": 3}, "illustrative": {"const": true}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "chart"}}, "required": ["type"]},
          "then": {
            "required": ["data_ref"],
            "properties": {"data_ref": {"type": "object"}}
          }
        }
      ]
    }
  }
}
